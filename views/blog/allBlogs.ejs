<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>All Blogs | Draftora</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-950 text-white">

  <%- include('../partials/navbar') %>

  <div class="p-6 md:p-10 min-h-screen">

    <!-- HEADER -->
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-3xl md:text-4xl font-bold">Explore Blogs</h1>

    </div>

    <!-- BLOG GRID -->
    <% if (blogs.length > 0) { %>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">

      <% blogs.forEach(blog => { %>
      <div class="bg-gray-900 rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition duration-300 transform hover:-translate-y-1">

        <div class="overflow-hidden">
          <img src="<%= blog.coverImage %>" class="w-full h-48 object-cover hover:scale-105 transition duration-300" />
        </div>

        <div class="p-5">

          <h2 class="text-xl font-semibold mb-2 line-clamp-2">
            <%= blog.title %>
          </h2>

          <div class="flex items-center gap-3 mb-3">
            <img src="<%= blog.author.profileImage %>" class="w-8 h-8 rounded-full object-cover" />
            <p class="text-gray-400 text-sm">
              <%= blog.author.name %>
            </p>
          </div>

          <a href="/blog/<%= blog._id %>" class="inline-block mt-2 text-blue-400 hover:text-blue-300 font-medium">
            Read More →
          </a>

        </div>

      </div>
      <% }) %>

    </div>

    <% } else { %>
    <div class="text-center mt-20">
      <h2 class="text-2xl font-semibold mb-2">No blogs yet 📝</h2>
      <p class="text-gray-400">Be the first to share something amazing!</p>
    </div>

    <% } %>

  </div>

</body>

</html>