<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title><%= blog.title %> | Draftora</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-950 text-white">

  <%- include('../partials/navbar') %>

  <div class="max-w-4xl mx-auto px-4 py-10">

    <div class="mb-8 overflow-hidden rounded-2xl shadow-lg">
      <img src="<%= blog.coverImage %>" class="w-full max-h-[450px] object-cover" />
    </div>


    <h1 class="text-3xl md:text-5xl font-bold mb-4 leading-tight">
      <%= blog.title %>
    </h1>


    <div class="flex items-center gap-3 mb-6">

      <img src="<%= blog.author.profileImage %>" class="w-10 h-10 rounded-full object-cover border border-gray-700" />

      <div>
        <p class="text-sm font-medium">
          <%= blog.author.name %>
        </p>
        <p class="text-xs text-gray-400">
          <%= blog.createdAt.toDateString() %>
        </p>
      </div>

    </div>

    <hr class="border-gray-800 mb-6" />


    <div class="text-lg leading-relaxed text-gray-300 space-y-4">

      <p class="whitespace-pre-line">
        <%= blog.content %>
      </p>

    </div>

    <div class="mt-10 flex justify-between items-center">

      <a href="/" class="text-blue-400 hover:text-blue-300 transition">
        ← Back to Blogs
      </a>

      <% if (user && blog.author._id.toString() === user._id.toString()) { %>
      <div class="space-x-2">

        <a href="/blog/edit/<%= blog._id %>" class="bg-yellow-500 hover:bg-yellow-600 px-4 py-2 rounded-lg text-sm">
          Edit
        </a>

        <form action="/blog/delete/<%= blog._id %>" method="POST" class="inline delete-form">
          <button class="bg-red-500 hover:bg-red-600 px-4 py-2 rounded-lg text-sm">
            Delete
          </button>
        </form>

      </div>
      <% } %>

    </div>

  </div>

  <script>
    const forms = document.querySelectorAll(".delete-form");

    forms.forEach(form => {
      form.addEventListener("submit", function(e) {
        const confirmDelete = confirm("Are you sure you want to delete this blog?");
        if (!confirmDelete) {
          e.preventDefault();
        }
      });
    });
  </script>

</body>

</html>