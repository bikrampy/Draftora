<% if(success && success.length > 0) { %>
<div class="mb-4 bg-green-500/20 border border-green-500 text-green-300 px-4 py-3 rounded-lg">
  <%= success[0] %>
</div>
<% } %>

<% if(error && error.length > 0) { %>
<div class="mb-4 bg-red-500/20 border border-red-500 text-red-300 px-4 py-3 rounded-lg">
  <%= error[0] %>
</div>
<% } %>