<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>Reset Password | Draftora</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-950 text-white min-h-screen flex items-center justify-center px-4">

  <div class="bg-gray-900 p-8 rounded-2xl shadow-xl w-full max-w-md">

    <h1 class="text-3xl font-bold text-center mb-3">
      Reset Password
    </h1>

    <p class="text-gray-400 text-center text-sm mb-6">
      Set a new password for
      <br>
      <span class="text-white"><%= email %></span>
    </p>

    <form action="/reset-password" method="POST" class="space-y-4">

      <input type="hidden" name="email" value="<%= email %>" />

      <input type="password" name="password" placeholder="New Password" required class="w-full p-3 rounded-lg bg-gray-800" />

      <input type="password" name="confirmPassword" placeholder="Confirm Password" required class="w-full p-3 rounded-lg bg-gray-800" />

      <button type="submit" class="w-full bg-green-600 hover:bg-green-700 p-3 rounded-lg font-semibold">
        Reset Password
      </button>

    </form>

    <p class="text-center mt-4">
      <a href="/login" class="text-blue-400">Back to Login</a>
    </p>

  </div>

</body>

</html>