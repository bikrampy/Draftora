<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>Forgot Password | Draftora</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-950 text-white min-h-screen flex items-center justify-center">

  <div class="bg-gray-900 p-8 rounded-2xl w-full max-w-md">

    <h1 class="text-3xl font-bold mb-4 text-center">
      Forgot Password
    </h1>

    <p class="text-gray-400 text-sm text-center mb-6">
      Enter your email to receive OTP
    </p>

    <form action="/forgot-password" method="POST" class="space-y-4">

      <input type="email" name="email" placeholder="Enter your email" required class="w-full p-3 rounded bg-gray-800" />

      <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 p-3 rounded">
        Send OTP
      </button>

    </form>

    <p class="text-center mt-4">
      <a href="/login" class="text-blue-400">Back to Login</a>
    </p>

  </div>

</body>

</html>