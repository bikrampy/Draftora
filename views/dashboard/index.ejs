<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>Dashboard | Draftora</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-950 text-white">

  <%- include('../partials/navbar') %>

  <div class="max-w-6xl mx-auto px-4 py-8">

    <div class="bg-gray-900/90 backdrop-blur-md p-6 rounded-2xl shadow-lg mb-10 flex flex-col md:flex-row items-center md:items-start gap-6">

      <img src="<%= user.profileImage %>" class="w-24 h-24 rounded-full object-cover border-2 border-gray-700 shadow-md" />

      <div class="flex-1 text-center md:text-left">
        <h1 class="text-2xl font-bold mb-2"><%= user.name %></h1>
        <p class="text-gray-400 mb-4"><%= user.email %></p>

        <a href="/profile/edit" class="inline-block bg-blue-600 hover:bg-blue-700 transition px-5 py-2 rounded-lg text-sm font-medium">
          Edit Profile
        </a>
      </div>

    </div>

    <!-- BLOG SECTION HEADER -->
    <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-4 mb-6">

      <h2 class="text-2xl font-semibold">Your Blogs</h2>

      <div class="flex gap-3">

        <a href="/blog/create" class="bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded-lg text-sm font-medium">
          + Create Blog
        </a>

        <a href="/" class="text-blue-400 hover:text-blue-300 text-sm flex items-center">
          View All →
        </a>

      </div>

    </div>

    <!-- BLOG LIST -->
    <% if (blogs.length > 0) { %>

    <div class="space-y-4">

      <% blogs.forEach(blog => { %>
      <div class="bg-gray-900 p-5 rounded-xl shadow-md flex flex-col md:flex-row justify-between md:items-center gap-4 hover:shadow-xl transition duration-300">

        <div>
          <h3 class="text-lg font-semibold line-clamp-1">
            <%= blog.title %>
          </h3>
          <p class="text-gray-400 text-sm mt-1">
            <%= blog.createdAt.toDateString() %>
          </p>
        </div>

        <div class="flex flex-wrap gap-2">

          <a href="/blog/<%= blog._id %>" class="bg-gray-700 hover:bg-gray-600 px-3 py-1 rounded text-sm">
            View
          </a>

          <a href="/blog/edit/<%= blog._id %>" class="bg-yellow-500 hover:bg-yellow-600 px-3 py-1 rounded text-sm">
            Edit
          </a>

          <form action="/blog/delete/<%= blog._id %>" method="POST" class="delete-form">
            <button class="bg-red-500 hover:bg-red-600 px-3 py-1 rounded text-sm">
              Delete
            </button>
          </form>

        </div>

      </div>
      <% }) %>

    </div>

    <% } else { %>

    <div class="text-center mt-20">

      <h3 class="text-xl font-semibold mb-2">No blogs yet 📝</h3>
      <p class="text-gray-400 mb-6">
        Start writing your first blog and share your ideas!
      </p>

      <a href="/blog/create" class="bg-blue-600 hover:bg-blue-700 px-6 py-2 rounded-lg">
        Create Your First Blog
      </a>

    </div>

    <% } %>

  </div>

  <script>
    const forms = document.querySelectorAll(".delete-form");

    forms.forEach(form => {
      form.addEventListener("submit", function(e) {
        const confirmDelete = confirm("Are you sure you want to delete this blog?");
        if (!confirmDelete) {
          e.preventDefault();
        }
      });
    });
  </script>

</body>

</html>